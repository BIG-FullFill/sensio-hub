# Attendee self-hosted Meeting Bot sidecar environment
DJANGO_SETTINGS_MODULE=attendee.settings.production
DJANGO_SECRET_KEY=replace-with-django-secret-key
CREDENTIALS_ENCRYPTION_KEY=replace-with-fernet-key
ALLOWED_HOSTS=*
DJANGO_SSL_REQUIRE=false
POSTGRES_SSL_REQUIRE=false
DATABASE_URL=postgresql://postgres:password@shared-postgres:5432/sensio_meeting_bot
MEETING_BOT_REDIS_URL=redis://shared-redis:6379/2
STORAGE_PROTOCOL=s3
AWS_ACCESS_KEY_ID=replace-with-s3-key
AWS_SECRET_ACCESS_KEY=replace-with-s3-secret
AWS_DEFAULT_REGION=ap-southeast-3
AWS_RECORDING_STORAGE_BUCKET_NAME=replace-with-bucket
DISABLE_EMAIL=true
REQUIRE_PUBLIC_WEBHOOK_URLS=false
SITE_DOMAIN=notes.sensio.id
MAX_CONCURRENT_BOTS=2
