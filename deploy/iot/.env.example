# ==============================================================================
# Sensio IoT Environment Configuration Template
# Make a copy of this file as `.env` and set permissions: chmod 600 .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (Required)
# PostgreSQL connection string with credentials and database target.
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://sensio_user:sensio_password@127.0.0.1:5432/sensio_iot
DATABASE_SCHEMA=sensio-iot

# ------------------------------------------------------------------------------
# 2. Security & Encryption Keys (Required)
# Path to 32-byte binary key used to encrypt device credentials & tokens at rest.
# Generate with: openssl rand 32 > .secrets/device_token_encryption_key
# ------------------------------------------------------------------------------
DEVICE_TOKEN_ENCRYPTION_KEY_HOST_PATH=./.secrets/device_token_encryption_key

# ------------------------------------------------------------------------------
# 3. HTTP Server Settings
# ------------------------------------------------------------------------------
SENSIO_IOT_HOST_BIND=0.0.0.0
SENSIO_IOT_HOST_PORT=3000
BIND_ADDR=0.0.0.0:3000
TRUST_PROXY_HEADERS=false

# ------------------------------------------------------------------------------
# 4. MQTT Broker Configuration
# By default, Sensio manages its embedded/shared Mosquitto broker container.
# Set MANAGED_MQTT_BROKER_ENABLED=false if connecting to an external broker.
# ------------------------------------------------------------------------------
MANAGED_MQTT_BROKER_ENABLED=true
MQTT_BROKER_HOST=
MQTT_BROKER_PORT=1883
MQTT_CLIENT_ID_SUFFIX=

# ------------------------------------------------------------------------------
# 5. Sensio AI Assistant & Voice Settings
# ------------------------------------------------------------------------------
SENSIO_AI_ENABLED=true
SENSIO_OPENAI_OAUTH_ENABLED=false

# Optional Deepgram Voice-to-Text key (leave blank to disable STT):
DEEPGRAM_API_KEY=
DEEPGRAM_API_BASE_URL=https://api.deepgram.com/v1
DEEPGRAM_MODEL=nova-3

# Text-to-Speech (Edge-TTS built into container image):
ASSISTANT_TTS_BIN=/opt/edge-tts/bin/edge-tts
ASSISTANT_TTS_VOICE=id-ID-GadisNeural
ASSISTANT_TTS_PITCH=-10Hz
ASSISTANT_TTS_RATE=+10%

# ------------------------------------------------------------------------------
# 6. Logging
# ------------------------------------------------------------------------------
RUST_LOG=sensio_iot=info,tower_http=info
